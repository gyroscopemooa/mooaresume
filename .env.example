# Server-only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
# FINAL은 서류-이력서 대조·주장 근거 추적처럼 QUICK/PRO보다 무거운 판단을
# 요구합니다. 둘 다 비워 두면 FINAL도 조용히 위 OPENAI_MODEL로 돌아갑니다 —
# FINAL 전용 값을 안 넣었다고 분석이 막히면 안 됩니다.
OPENAI_MODEL_FINAL=
# low | medium | high 등, 쓰는 모델이 지원하는 값. 비워 두면 reasoning 파라미터
# 자체를 보내지 않습니다(모델 기본값).
OPENAI_REASONING_EFFORT_FINAL=
# 관리자 화면의 원가 표시용. 100만 토큰당 USD 단가입니다 — 입력과 출력을
# 반드시 따로 넣어 주세요(출력이 몇 배 비싸, 합계에 한 단가를 곱하면 크게
# 틀립니다). 비워 두면 금액을 계산하지 않고 토큰 수만 보여 줍니다.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# FINAL이 OPENAI_MODEL_FINAL로 다른(보통 더 비싼) 모델을 쓰면 위 단가로는
# 원가가 틀립니다. FINAL 전용 모델을 쓰는 동안은 이 값도 함께 채워 주세요.
# OPENAI_MODEL_FINAL이 비어 있으면(=FINAL도 기본 모델을 씀) 이 값은 안 읽고
# 위 기본 단가를 그대로 씁니다.
OPENAI_PRICE_INPUT_PER_1M_FINAL=
OPENAI_PRICE_OUTPUT_PER_1M_FINAL=
# 원화 환산 환율. 비우면 1400으로 계산합니다.
USD_KRW_RATE=
RUN_LIVE_EVAL=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_QUICK_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
# Optional. FINAL has no live Polar product yet; leave blank and FINAL checkout
# fails by name instead of taking QUICK and PRO down with it.
POLAR_FINAL_PRODUCT_ID=
POLAR_SERVER=sandbox
NEXT_PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 예약 작업이 /api/analysis-runs/advance 를 호출할 때 쓰는 공유 비밀.
# 비어 있으면 그 엔드포인트는 항상 거부합니다.
ANALYSIS_CRON_SECRET=

# 완료 이메일. 두 값이 모두 있어야 발송되고, 없으면 조용히 건너뜁니다.
# 발신 도메인은 Resend에서 소유 인증이 되어 있어야 합니다.
RESEND_API_KEY=
ANALYSIS_EMAIL_FROM=
# Replies to any mail we send land here. The sender is a noreply address, so
# without this a reply goes nowhere anyone reads.
ANALYSIS_EMAIL_REPLY_TO=
